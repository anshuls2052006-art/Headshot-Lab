rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'anshuls2052006@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isBoundedStringList(arr, maxItems, maxItemLen) {
      return arr is list && arr.size() <= maxItems && (
        arr.size() == 0 || (arr[0] is string && arr[0].size() <= maxItemLen)
      );
    }

    function isValidSensitivityMap(s, scaleMax) {
      return s is map &&
        s.keys().hasAll(['general', 'red_dot', 'scope_2x', 'scope_4x', 'sniper_scope', 'free_look']) &&
        s.keys().hasOnly(['general', 'red_dot', 'scope_2x', 'scope_4x', 'sniper_scope', 'free_look']) &&
        s.general is int && s.general >= 0 && s.general <= scaleMax &&
        s.red_dot is int && s.red_dot >= 0 && s.red_dot <= scaleMax &&
        s.scope_2x is int && s.scope_2x >= 0 && s.scope_2x <= scaleMax &&
        s.scope_4x is int && s.scope_4x >= 0 && s.scope_4x <= scaleMax &&
        s.sniper_scope is int && s.sniper_scope >= 0 && s.sniper_scope <= scaleMax &&
        s.free_look is int && s.free_look >= 0 && s.free_look <= scaleMax;
    }

    function isValidReasoningMap(r) {
      return r is map &&
        r.keys().hasAll(['general', 'red_dot', 'scope_2x', 'scope_4x', 'sniper_scope', 'free_look']) &&
        r.keys().hasOnly(['general', 'red_dot', 'scope_2x', 'scope_4x', 'sniper_scope', 'free_look']) &&
        isBoundedString(r.general, 1, 800) &&
        isBoundedString(r.red_dot, 1, 800) &&
        isBoundedString(r.scope_2x, 1, 800) &&
        isBoundedString(r.scope_4x, 1, 800) &&
        isBoundedString(r.sniper_scope, 1, 800) &&
        isBoundedString(r.free_look, 1, 800);
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'preferredLanguage', 'themeMode', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'selectedDeviceId', 'selectedDeviceName', 'preferredLanguage', 'themeMode', 'favoriteWeapons', 'gameplayStyles', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        isBoundedString(data.email, 3, 254) &&
        isBoundedString(data.displayName, 1, 80) &&
        data.preferredLanguage in ['en', 'hi'] &&
        data.themeMode in ['dark', 'amoled'] &&
        (!('selectedDeviceId' in data) || isBoundedString(data.selectedDeviceId, 0, 128)) &&
        (!('selectedDeviceName' in data) || isBoundedString(data.selectedDeviceName, 0, 120)) &&
        (!('favoriteWeapons' in data) || isBoundedStringList(data.favoriteWeapons, 10, 40)) &&
        (!('gameplayStyles' in data) || isBoundedStringList(data.gameplayStyles, 10, 50)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt']) &&
        isValidId(data.uid) &&
        isBoundedString(data.email, 3, 254) &&
        (!('grantedBy' in data) || isBoundedString(data.grantedBy, 1, 128)) &&
        data.createdAt is timestamp;
    }

    function isValidDevice(data) {
      return data.keys().hasAll(['id', 'brand', 'series', 'model', 'ramVariants', 'storageVariants', 'processor', 'refreshRates', 'resolution', 'displaySize', 'os', 'fpsOptions', 'releaseYear', 'tier', 'verified', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'brand', 'series', 'model', 'ramVariants', 'storageVariants', 'processor', 'refreshRates', 'resolution', 'displaySize', 'os', 'fpsOptions', 'releaseYear', 'tier', 'verified', 'archived', 'createdAt', 'updatedAt', 'updatedBy']) &&
        isValidId(data.id) &&
        isBoundedString(data.brand, 1, 60) &&
        isBoundedString(data.series, 1, 60) &&
        isBoundedString(data.model, 1, 100) &&
        isBoundedStringList(data.ramVariants, 10, 20) &&
        isBoundedStringList(data.storageVariants, 10, 20) &&
        isBoundedString(data.processor, 1, 120) &&
        data.refreshRates is list && data.refreshRates.size() >= 1 && data.refreshRates.size() <= 6 && data.refreshRates[0] is int &&
        isBoundedString(data.resolution, 3, 40) &&
        isBoundedString(data.displaySize, 2, 30) &&
        isBoundedString(data.os, 2, 50) &&
        isBoundedStringList(data.fpsOptions, 6, 30) &&
        data.releaseYear is int && data.releaseYear >= 2015 && data.releaseYear <= 2030 &&
        data.tier in ['budget', 'mid-range', 'flagship', 'gaming'] &&
        data.verified is bool &&
        (!('archived' in data) || data.archived is bool) &&
        (!('updatedBy' in data) || isBoundedString(data.updatedBy, 1, 128)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSensitivityProfile(data) {
      return data.keys().hasAll(['id', 'userId', 'deviceName', 'deviceBrand', 'deviceModel', 'deviceTier', 'isCustomDevice', 'isTestedSetting', 'gameplayStyles', 'accuracyFocus', 'favoriteWeapons', 'sensitivityScaleMax', 'sensitivity', 'reasoning', 'weaponRecommendations', 'calibrationTips', 'confidence', 'limitations', 'isFavorite', 'shareCode', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'deviceName', 'deviceBrand', 'deviceModel', 'deviceTier', 'isCustomDevice', 'isTestedSetting', 'gameplayStyles', 'accuracyFocus', 'favoriteWeapons', 'sensitivityScaleMax', 'sensitivity', 'reasoning', 'weaponRecommendations', 'calibrationTips', 'confidence', 'limitations', 'parentProfileId', 'calibrationIssue', 'isFavorite', 'shareCode', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isBoundedString(data.deviceName, 1, 140) &&
        isBoundedString(data.deviceBrand, 1, 60) &&
        isBoundedString(data.deviceModel, 1, 100) &&
        data.deviceTier in ['budget', 'mid-range', 'flagship', 'gaming', 'custom'] &&
        data.isCustomDevice is bool &&
        data.isTestedSetting is bool &&
        isBoundedStringList(data.gameplayStyles, 10, 60) &&
        isBoundedString(data.accuracyFocus, 1, 80) &&
        isBoundedStringList(data.favoriteWeapons, 10, 40) &&
        data.sensitivityScaleMax is int && data.sensitivityScaleMax >= 100 && data.sensitivityScaleMax <= 400 &&
        isValidSensitivityMap(data.sensitivity, data.sensitivityScaleMax) &&
        isValidReasoningMap(data.reasoning) &&
        isBoundedStringList(data.weaponRecommendations, 10, 500) &&
        isBoundedStringList(data.calibrationTips, 10, 500) &&
        isBoundedString(data.confidence, 1, 60) &&
        isBoundedStringList(data.limitations, 10, 500) &&
        (!('parentProfileId' in data) || isBoundedString(data.parentProfileId, 0, 128)) &&
        (!('calibrationIssue' in data) || isBoundedString(data.calibrationIssue, 0, 140)) &&
        data.isFavorite is bool &&
        isValidId(data.shareCode) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSharedProfile(data) {
      return data.keys().hasAll(['shareId', 'ownerId', 'deviceName', 'gameplayStyles', 'accuracyFocus', 'sensitivityScaleMax', 'sensitivity', 'reasoning', 'confidence', 'createdAt']) &&
        data.keys().hasOnly(['shareId', 'ownerId', 'deviceName', 'gameplayStyles', 'accuracyFocus', 'sensitivityScaleMax', 'sensitivity', 'reasoning', 'confidence', 'createdAt']) &&
        isValidId(data.shareId) &&
        isValidId(data.ownerId) &&
        isBoundedString(data.deviceName, 1, 140) &&
        isBoundedStringList(data.gameplayStyles, 10, 60) &&
        isBoundedString(data.accuracyFocus, 1, 80) &&
        data.sensitivityScaleMax is int && data.sensitivityScaleMax >= 100 && data.sensitivityScaleMax <= 400 &&
        isValidSensitivityMap(data.sensitivity, data.sensitivityScaleMax) &&
        isValidReasoningMap(data.reasoning) &&
        isBoundedString(data.confidence, 1, 60) &&
        data.createdAt is timestamp;
    }

    function isValidDeviceRequest(data) {
      return data.keys().hasAll(['id', 'userId', 'brand', 'model', 'ram', 'processor', 'refreshRate', 'resolution', 'os', 'fpsOption', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'brand', 'model', 'ram', 'processor', 'refreshRate', 'resolution', 'os', 'fpsOption', 'notes', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isBoundedString(data.brand, 1, 60) &&
        isBoundedString(data.model, 1, 100) &&
        isBoundedString(data.ram, 1, 30) &&
        isBoundedString(data.processor, 1, 100) &&
        isBoundedString(data.refreshRate, 1, 30) &&
        isBoundedString(data.resolution, 1, 40) &&
        isBoundedString(data.os, 1, 40) &&
        isBoundedString(data.fpsOption, 1, 30) &&
        (!('notes' in data) || isBoundedString(data.notes, 0, 400)) &&
        data.status in ['pending', 'approved', 'rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserReport(data) {
      return data.keys().hasAll(['id', 'userId', 'targetType', 'title', 'description', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'targetType', 'targetId', 'title', 'description', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.targetType in ['device', 'sensitivity', 'bug'] &&
        (!('targetId' in data) || isBoundedString(data.targetId, 0, 128)) &&
        isBoundedString(data.title, 3, 120) &&
        isBoundedString(data.description, 5, 600) &&
        data.status in ['open', 'resolved', 'dismissed'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAppSettings(data) {
      return data.keys().hasAll(['sensitivityScaleMax', 'dailyAiLimitPerUser', 'announcementBanner', 'updatedAt']) &&
        data.keys().hasOnly(['sensitivityScaleMax', 'dailyAiLimitPerUser', 'announcementBanner', 'updatedAt']) &&
        data.sensitivityScaleMax is int && data.sensitivityScaleMax >= 100 && data.sensitivityScaleMax <= 400 &&
        data.dailyAiLimitPerUser is int && data.dailyAiLimitPerUser >= 1 && data.dailyAiLimitPerUser <= 1000 &&
        isBoundedString(data.announcementBanner, 0, 240) &&
        data.updatedAt is timestamp;
    }

    function isValidAiUsageLog(data) {
      return data.keys().hasAll(['userId', 'dateKey', 'count', 'lastModel', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'dateKey', 'count', 'lastModel', 'updatedAt']) &&
        isValidId(data.userId) &&
        isBoundedString(data.dateKey, 10, 10) && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.count is int && data.count >= 1 && data.count <= 1000 &&
        isBoundedString(data.lastModel, 1, 80) &&
        data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // Connectivity probe
    match /test/connection {
      allow get: if true;
    }

    // Users (strict PII isolation)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUser(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUser(incoming()) && (
          isAdmin() || (
            isOwner(userId) &&
            incoming().uid == existing().uid &&
            incoming().email == existing().email &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'selectedDeviceId', 'selectedDeviceName',
              'preferredLanguage', 'themeMode', 'favoriteWeapons',
              'gameplayStyles', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // Admin registry
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(userId) && isValidAdminRecord(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(userId) && isValidAdminRecord(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Public verified device database (No PII)
    match /devices/{deviceId} {
      allow get: if isValidId(deviceId);
      allow list: if true;
      allow create: if isAdmin() &&
        isValidId(deviceId) &&
        isValidDevice(incoming()) &&
        incoming().id == deviceId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(deviceId) &&
        isValidDevice(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(deviceId);
    }

    // Sensitivity profiles (User-owned + calibration history)
    match /sensitivityProfiles/{profileId} {
      allow get: if isSignedIn() && isValidId(profileId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(profileId) &&
        isValidSensitivityProfile(incoming()) &&
        incoming().id == profileId &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(profileId) &&
        isValidSensitivityProfile(incoming()) && (
          isAdmin() || (
            existing().userId == request.auth.uid &&
            incoming().id == existing().id &&
            incoming().userId == existing().userId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['isFavorite', 'updatedAt', 'sensitivity', 'reasoning', 'calibrationTips'])
          )
        );
      allow delete: if isSignedIn() && isValidId(profileId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Shareable sensitivity profiles (No PII; get by shareId only)
    match /sharedProfiles/{shareId} {
      allow get: if isValidId(shareId);
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(shareId) &&
        isValidSharedProfile(incoming()) &&
        incoming().shareId == shareId &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow delete: if isSignedIn() && isValidId(shareId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Unlisted device submission requests
    match /deviceRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(requestId) &&
        isValidDeviceRequest(incoming()) &&
        incoming().id == requestId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(requestId) &&
        isValidDeviceRequest(incoming()) &&
        existing().status == 'pending' &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(requestId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // User error/feedback reports
    match /userReports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(reportId) &&
        isValidUserReport(incoming()) &&
        incoming().id == reportId &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(reportId) &&
        isValidUserReport(incoming()) &&
        existing().status == 'open' &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(reportId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Admin global configuration
    match /appSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isAdmin();
      allow create, update: if isAdmin() &&
        isValidId(settingId) &&
        isValidAppSettings(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Per-user daily AI usage log
    match /aiUsageLogs/{usageId} {
      allow get: if isSignedIn() && isValidId(usageId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(usageId) &&
        isValidAiUsageLog(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().count == 1 &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(usageId) &&
        isValidAiUsageLog(incoming()) && (
          isAdmin() || (
            existing().userId == request.auth.uid &&
            incoming().userId == existing().userId &&
            incoming().dateKey == existing().dateKey &&
            incoming().count == existing().count + 1 &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['count', 'lastModel', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(usageId);
    }
  }
}
